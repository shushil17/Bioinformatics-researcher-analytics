# Copy to .env and fill in. Never commit .env.

# Which LLM backend the agent uses: bedrock | gemini
LLM_PROVIDER=bedrock

# --- Amazon Bedrock (Converse API) ---
# Bedrock API key (console: Bedrock > API keys). Short-term keys expire within 12 h.
# Alternatively leave this unset and use `aws configure` credentials.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Amazon Nova works on most accounts; Claude (e.g. anthropic.claude-opus-5) needs account access
BEDROCK_MODEL=us.amazon.nova-pro-v1:0

# --- Google Gemini (optional fallback) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# MAX_AGENT_STEPS=14
